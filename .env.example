DATABASE_URL="postgresql://taskcoin:taskcoin@localhost:5432/taskcoin"
# Mindestens 32 Zeichen, zufällig. Erzeugen mit: openssl rand -base64 48
AUTH_SECRET=""
# Nur für das Seed-Skript (erster Admin)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Schützt den Cron-Endpunkt /api/cron/auto-approve. Erzeugen mit: openssl rand -base64 32
CRON_SECRET=""

# "simulated" = Kauf und Auszahlung sind Test-Funktionen, es fließt kein echtes Geld.
# Jeder andere Wert schaltet sie ab, bis ein echter Zahlungsanbieter angebunden ist.
PAYMENTS_MODE="simulated"

# Öffentliche Adresse der App (für Links in E-Mails)
APP_URL="http://localhost:3000"
# E-Mail-Versand über Resend (resend.com). Ohne Key wird der Link nur im Server-Terminal ausgegeben (nur Entwicklung).
RESEND_API_KEY=""
MAIL_FROM="TaskCoin <noreply@deine-domain.de>"

# Nur für `npm test`: eigene Datenbank, wird von den Tests geleert. Der Name muss "test" enthalten.
# Am besten in eine Datei .env.test schreiben.
TEST_DATABASE_URL="postgresql://taskcoin:taskcoin@localhost:5433/taskcoin_test"
